        <field name="ttype">many2one</field>
        <field name="relation">purchase.order</field>
    </record>

    <record id="field_greenbear_precommitment_season_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_season_id</field><field name="field_description">Saison</field>
        <field name="ttype">many2one</field><field name="relation">x_greenbear.season</field>
    </record>
    <record id="field_greenbear_precommitment_module_area_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>

        <field name="field_description">Bindungsstatus</field>
        <field name="ttype">selection</field>
        <field name="required">True</field>
    </record>
    <record id="selection_greenbear_precommitment_draft" model="ir.model.fields.selection">
        <field name="field_id" ref="greenbear_procurement.field_greenbear_precommitment_state"/>
        <field name="name">Vorgemerkt</field><field name="value">draft</field><field name="sequence">10</field>
    </record>
    <record id="selection_greenbear_precommitment_active" model="ir.model.fields.selection">
        <field name="field_id" ref="greenbear_procurement.field_greenbear_precommitment_state"/>
        <field name="name">Aktiv</field><field name="value">active</field><field name="sequence">20</field>
    </record>
    <record id="selection_greenbear_precommitment_transferred" model="ir.model.fields.selection">
        <field name="field_id" ref="greenbear_procurement.field_greenbear_precommitment_state"/>
        <field name="name">An Bestellung übergeben</field><field name="value">transferred</field><field name="sequence">30</field>
    </record>
    <record id="selection_greenbear_precommitment_released" model="ir.model.fields.selection">
        <field name="field_id" ref="greenbear_procurement.field_greenbear_precommitment_state"/>
        <field name="name">Freigegeben (aufgelöst)</field><field name="value">released</field><field name="sequence">40</field>
    </record>
    <record id="selection_greenbear_precommitment_cancelled" model="ir.model.fields.selection">
        <field name="field_id" ref="greenbear_procurement.field_greenbear_precommitment_state"/>
        <field name="name">Storniert</field><field name="value">cancelled</field><field name="sequence">50</field>
    </record>

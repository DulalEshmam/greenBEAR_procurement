        <field name="on_delete">restrict</field>
        <field name="index">True</field>
    </record>
    <record id="field_greenbear_precommitment_budget_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_budget_id</field>
        <field name="field_description">greenBEAR-Budget</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_greenbear.budget</field>
        <field name="required">True</field>
        <field name="on_delete">restrict</field>
        <field name="index">True</field>
    </record>

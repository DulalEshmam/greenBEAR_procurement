        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>
        <field name="name">x_component_id</field>
        <field name="field_description">Baugruppe/Komponente</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_greenbear.component</field>
        <field name="required">True</field>
        <field name="on_delete">restrict</field>
    </record>
    <record id="field_greenbear_budget_subcategory_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>
        <field name="name">x_subcategory_id</field>
        <field name="field_description">Unterkategorie</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_greenbear.subcategory</field>

        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>
        <field name="name">x_last_refresh</field>
        <field name="field_description">Letzte Aktualisierung</field>
        <field name="ttype">datetime</field>
    </record>
    <record id="field_greenbear_budget_overrun" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>

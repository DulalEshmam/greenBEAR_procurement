        <field name="field_description">Odoo-Budgetreferenz</field>
        <field name="ttype">char</field>
        <field name="help">Bezeichnung des zugehörigen nativen Odoo-Kostenstellenbudgets.</field>
    </record>

    <record id="field_greenbear_budget_season_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>

        <field name="field_description">Budget überschritten</field>
        <field name="ttype">boolean</field>
    </record>
    <record id="field_greenbear_budget_overrun_notified" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>
        <field name="name">x_overrun_notified</field>
        <field name="field_description">Finance-Aktivität erzeugt</field>
        <field name="ttype">boolean</field>
    </record>
    <record id="field_greenbear_precommitment_reference" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_reference</field>
        <field name="field_description">Bindungsreferenz</field>
        <field name="ttype">char</field>
        <field name="index">True</field>
    </record>
    <record id="field_greenbear_precommitment_name" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_name</field>
        <field name="field_description">Bezeichnung</field>
        <field name="ttype">char</field>
        <field name="required">True</field>
    </record>
    <record id="field_greenbear_precommitment_procurement_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_procurement_id</field>
        <field name="field_description">Beschaffungsvorgang</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_greenbear.procurement</field>

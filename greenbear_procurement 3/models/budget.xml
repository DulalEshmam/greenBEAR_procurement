        <field name="field_description">Finanzierungsquelle</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_greenbear.funding_source</field>
        <field name="required">True</field>
        <field name="on_delete">restrict</field>
    </record>

    <record id="field_greenbear_budget_budgeted_amount" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>
        <field name="name">x_budgeted_amount</field>
        <field name="field_description">Budgetiert (EUR)</field>
        <field name="ttype">float</field>
        <field name="required">True</field>
        <field name="help">Für den Pilot aus dem zugeordneten nativen Odoo-Budget übernommener Budgetbetrag.</field>
    </record>
    <record id="field_greenbear_budget_active_precommitment_amount" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>

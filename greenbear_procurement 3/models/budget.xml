        <field name="ttype">many2one</field><field name="relation">x_greenbear.module_area</field>
    </record>
    <record id="field_greenbear_precommitment_component_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_component_id</field><field name="field_description">Baugruppe/Komponente</field>
        <field name="ttype">many2one</field><field name="relation">x_greenbear.component</field>
    </record>
    <record id="field_greenbear_precommitment_subcategory_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_subcategory_id</field><field name="field_description">Unterkategorie</field>
        <field name="ttype">many2one</field><field name="relation">x_greenbear.subcategory</field>
    </record>
    <record id="field_greenbear_precommitment_funding_source_id" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_funding_source_id</field><field name="field_description">Finanzierungsquelle</field>
        <field name="ttype">many2one</field><field name="relation">x_greenbear.funding_source</field>
    </record>
    <record id="field_greenbear_precommitment_activated_on" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>

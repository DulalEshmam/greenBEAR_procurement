<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_greenbear_budget_name" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>
        <field name="name">x_name</field>
        <field name="field_description">Budgetbezeichnung</field>
        <field name="ttype">char</field>
        <field name="required">True</field>
        <field name="index">True</field>
    </record>
    <record id="field_greenbear_budget_odoo_reference" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_budget"/>

    </record>
    <record id="field_greenbear_precommitment_transferred_on" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_transferred_on</field><field name="field_description">Übergeben am</field><field name="ttype">datetime</field>
    </record>
    <record id="field_greenbear_precommitment_released_on" model="ir.model.fields">
        <field name="model_id" ref="greenbear_procurement.model_greenbear_precommitment"/>
        <field name="name">x_released_on</field><field name="field_description">Aufgelöst am</field><field name="ttype">datetime</field>
    </record>
